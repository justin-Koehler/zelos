{
  "$schema": "https://json-schema.org",
  "title": "ZelosPersonaTraits",
  "type": "object",
  "required": ["identity", "linguistic_style", "behavioral_boundaries"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["name", "core_role", "analytical_depth"],
      "properties": {
        "name": { "type": "string" },
        "core_role": { "type": "string" },
        "analytical_depth": { 
          "type": "string", 
          "enum": ["high", "medium", "concise"] 
        }
      }
    },
    "linguistic_style": {
      "type": "object",
      "required": ["tone_of_voice", "sentence_structure", "allowed_jargon"],
      "properties": {
        "tone_of_voice": { "type": "string" },
        "sentence_structure": { "type": "string" },
        "allowed_jargon": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "behavioral_boundaries": {
      "type": "object",
      "required": ["prohibited_phrases", "fallback_strategy"],
      "properties": {
        "prohibited_phrases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fallback_strategy": { "type": "string" }
      }
    }
  }
}
